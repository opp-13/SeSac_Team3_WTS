# ─────────────────────────────────────────────
# WTS MVP – 로컬 개발 환경변수
# 복사해서 사용: cp .env.example .env
# .env 는 git에 커밋하지 않는다 (CLAUDE.md §33)
# ─────────────────────────────────────────────

# ---- MySQL ----
# 호스트에 이미 MySQL이 3306을 쓰고 있다면 3307 등으로 바꾼다.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=wts
MYSQL_USER_DATABASE=wts_user
MYSQL_TRADING_DATABASE=wts_trading
MYSQL_MARKET_DATABASE=wts_market
MYSQL_USER=wts
MYSQL_PASSWORD=wts
MYSQL_ROOT_PASSWORD=root

# ---- Kafka ----
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ---- Valkey ----
# 호스트에 이미 redis가 6379를 쓰고 있다면 6380 등으로 바꾼다.
VALKEY_HOST=localhost
VALKEY_PORT=6379

# ---- 서비스 포트 ----
GATEWAY_PORT=8080
MARKET_PORT=8081
TRADING_PORT=8082
USER_PORT=8083
# 시세 수집 앱 market-ingest (CLAUDE.md §66). health 확인용
MARKET_INGEST_PORT=8084
KAFKA_UI_PORT=8090
FRONTEND_PORT=5173

# ---- Mock 인증 (CLAUDE.md §6.4) ----
# user-service가 토큰을 발급하고 gateway-service가 검증한다. 두 서비스가 같은 값을 공유한다.
# 운영에서는 반드시 별도 생성한 값을 주입한다. 실제 인증은 공개 배포 직전(Phase 11)에 Cognito로 교체한다 (CLAUDE.md §62.4).
AUTH_TOKEN_SECRET=change-me-local-dev-only
AUTH_TOKEN_TTL=24h

# ---- Market Data Provider (mock | kis) ----
MARKET_PROVIDER=mock

# ---- 한국투자증권 OpenAPI (MARKET_PROVIDER=kis 일 때만 사용) ----
# 시세 수신 전용이다. 주문 · 계좌 API는 쓰지 않으므로 계좌번호도 필요 없다 (CLAUDE.md §62.3).
# 모의투자(vts) 앱키만 쓴다. real은 지원하지 않고, 넣으면 기동이 멈춘다.
#   vts = 모의투자 (openapivts.koreainvestment.com:29443 / ops...:31000)
KIS_ENVIRONMENT=vts
KIS_APP_KEY=
KIS_APP_SECRET=

# 한 종목에 체결가·호가 두 건이 등록된다. 종목 수 × 2 가 이 값을 넘으면 기동에서 막는다.
KIS_SUBSCRIPTION_LIMIT=40
